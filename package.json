{
  "name": "dsh-buddy",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NOirBRight/dsh-buddy.git"
  },
  "homepage": "https://github.com/NOirBRight/dsh-buddy#readme",
  "description": "Pixel whale mascot on the 960×400 USB sub-screen: DSH mood dashboard and touch remote",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "import": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "page/**",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run && python3 -m unittest discover -s scripts -p \"*_test.py\"",
    "build": "pnpm run typecheck:client && tsc -p tsconfig.json && tsc -p tsconfig.client.declaration.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm run typecheck:client",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "pack:check": "python3 -m unittest discover -s scripts -p \"*_test.py\" && node scripts/check-artifact.mjs",
    "check:artifact": "node scripts/check-artifact.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session-title": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-user-questions": "0.1.2-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session-title": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-user-questions": "0.1.2-alpha.1"
  }
}
